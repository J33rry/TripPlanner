  "cards": [
    {
      "dot": "emerald", "title": "Trip generation",
      "items": [
        "precheck: non-empty, ≤1000 chars, contains letters",
        "classifyRequest (gpt-oss-safeguard-20b) must say “travel”",
        "extractPlaces (gpt-oss-20b) → Google Places candidates, 5 s budget",
        "gpt-oss-120b writes JSON; parse → snap to candidates → zod validate"
      ]
    },
    {
      "dot": "cyan", "title": "Maps & routing",
      "items": [
        "Each day's legs routed via /api/directions (debounced 350 ms)",
        "Google Routes first; 401/403 backs off 10 min to OSRM",
        "Finished legs saved with the trip, so reopening skips routing"
      ]
    },
    {
      "dot": "rose", "title": "Accounts & sharing",
      "items": [
        "Only email-verified Appwrite sessions count as signed in",
        "Trip rows are read/update/delete for their owner only",
        "Share link = random shareId; /share reads it with a server API key",
        "Shared view never returns the owner's row ID or permissions"
      ]
    },
    {
      "dot": "amber", "title": "Onboarding",
      "items": [
        "Fires on users.*.sessions.*.create — not callable over HTTP",
        "Sends once per verified user, tracked by a “welcomed” label"
      ]
    }
  ]
