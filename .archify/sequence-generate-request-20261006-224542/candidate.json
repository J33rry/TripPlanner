  "cards": [
    {
      "dot": "rose",
      "title": "Gates that stop the request",
      "items": [
        "precheck: empty, >1000 chars or no letters → 400",
        "Guardrail category ≠ travel → GuardrailError (not retryable)",
        "Guardrail outage → 503 retryable; Groq 429 → rate-limit message"
      ]
    },
    {
      "dot": "cyan",
      "title": "Grounding is optional",
      "items": [
        "On only with GOOGLE_MAPS_API_KEY and PLACE_GROUNDING ≠ off",
        "Off: planner call starts in parallel with the guardrail",
        "Refine mode reuses the saved trip's areas instead of extraction",
        "Any Places failure or timeout → plan without candidates"
      ]
    },
    {
      "dot": "emerald",
      "title": "Output checks",
      "items": [
        "gpt-oss uses strict json_schema; one retry on json_validate_failed",
        "Empty reply → 502; unparsable or schema mismatch → 422",
        "applyCandidates snaps activities to real coords (≤25 km)"
      ]
    }
  ]
