GROQ_API_KEY=
# Optional: override the Groq model used for generation (defaults to openai/gpt-oss-120b)
GROQ_MODEL=
# Browser key for the Maps JavaScript API (trip map). Public: restrict it to Maps JavaScript API + your site's addresses
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Google Cloud map ID for custom styling (defaults to DEMO_MAP_ID)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional server key for Google Places API (New); grounds itineraries in real places near the destination
GOOGLE_MAPS_API_KEY=
# Optional: set to "off" to disable place grounding even with a key
PLACE_GROUNDING=
