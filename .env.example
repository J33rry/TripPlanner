GROQ_API_KEY=
# Optional: override the Groq model used for generation (defaults to openai/gpt-oss-120b)
GROQ_MODEL=
# Browser key for the Maps JavaScript API (trip map). Public: restrict it to Maps JavaScript API + your site's addresses
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Google Cloud map ID for custom styling (defaults to DEMO_MAP_ID)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional server key for Google Places API (New) and Routes API: grounds itineraries in real places,
# and routes map legs along streets (falls back to the free OpenStreetMap router without it)
GOOGLE_MAPS_API_KEY=
# Optional: set to "off" to route with OpenStreetMap even when a Google key is present
GOOGLE_ROUTING=
# Optional: set to "off" to disable place grounding even with a key
PLACE_GROUNDING=
# Appwrite (accounts + saved trips). Create a project at https://cloud.appwrite.io, add a Web platform for
# your hostname (localhost for dev), and enable Google under Auth → Settings → OAuth2 providers.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
# Optional: defaults to "roam" / "roam_trips" — created by `npm run setup:appwrite`
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_TRIPS_TABLE_ID=
# Only for `npm run setup:appwrite` (server key with databases/tables/columns write scopes). Never exposed to the browser.
APPWRITE_API_KEY=
